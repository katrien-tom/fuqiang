    "servers": [
      {
        "tag": "local",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "public",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "local"
      },
      {
        "tag": "foreign",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "🚀 默认代理"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "local"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "fakeip"
      },
      {
        "rule_set": [
          "geosite-fakeipfilter",
          "geosite-cn",
          "geosite-private"
        ],
        "action": "route",
        "server": "local"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": [
              "A",
              "AAAA"
            ]
          },
          {
            "rule_set": "geosite-!cn",
            "invert": true
          }
        ],
        "action": "evaluate",
        "server": "foreign",
        "client_subnet": "223.5.5.0/24",
        "timeout": "2s"
      },
      {
        "match_response": true,
        "rule_set": "geoip-cn",
        "action": "route",
        "server": "local"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "fakeip",
        "rewrite_ttl": 1
      }
    ],
    "final": "foreign",
    "strategy": "ipv4_only",
    "reverse_mapping": true
  },
  "outbounds": [
    {
      "tag": "🚀 默认代理",
      "type": "selector",
